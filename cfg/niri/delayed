#!/run/current-system/sw/bin/bash

sleep 1;

nohup 1password --silent 2>&1 > /dev/null &
disown

# launch slack on work pc
if [ "$(hostname)" = "snorlax" ] || [ "$(hostname)" = "flareon" ]; then
    nohup slack 2>&1 > /dev/null &
    disown
fi

# NOTE: krisp is patched at build time in modules/home-manager/apps/general
# (discord_krisp.node lives in the read-only nix store, so it cannot be
# patched at login). Discord autostart intentionally disabled:
# nohup discord 2>&1 > /dev/null &
# disown
